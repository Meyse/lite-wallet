{
  "name": "verus-express",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "vite dev",
    "wipe": "./scripts/wipe-wallets.sh",
    "wipez": "./scripts/wipe-dlight.sh",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "lint": "pnpm lint:eslint && pnpm lint:ui",
    "lint:eslint": "eslint src scripts .pnpmfile.cjs eslint.config.js svelte.config.js vite.config.js .eslintrc.js",
    "lint:fix": "pnpm lint:eslint --fix",
    "lint:ui": "node ./scripts/lint-ui-style.mjs",
    "sync:verus-coins": "node ./scripts/sync-verus-coin-catalog.mjs",
    "check:verus-coins": "node ./scripts/check-verus-coin-catalog.mjs",
    "docs:check": "node ./scripts/docs-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test scripts/pnpmfile.node-test.cjs && vitest run",
    "test:watch": "vitest",
    "pre-commit": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm docs:check"
  },
  "license": "MIT",
