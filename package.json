    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.5.0",
    "jsdom": "27.0.0",
    "jsqr": "1.4.0",
    "mode-watcher": "^1.1.0",
    "nanoid": "^5.1.5",
    "prettier": "^3.6.2",
